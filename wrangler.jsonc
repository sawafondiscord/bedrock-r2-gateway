{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedrock-r2-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "bedrock-private-files" }
  ],
  "observability": { "enabled": false }
}
